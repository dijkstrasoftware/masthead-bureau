{
  "label": "Bureau · Home",
  "description": "A modular homepage. Hero, then any sections in any order.",
  "page_options": [
    {
      "key": "show_title",
      "label": "Show hero",
      "type": "boolean",
      "default": true,
      "description": "Untick to hide the title block (it stays available to screen readers).",
      "category": "Hero"
    },
    {
      "key": "hero_style",
      "label": "Hero style",
      "type": "select",
      "options": [
        "editorial",
        "split",
        "banner",
        "minimal"
      ],
      "default": "editorial",
      "description": "Editorial: large type, image below. Split: text beside image. Banner: text over image. Minimal: compact title.",
      "category": "Hero"
    },
    {
      "key": "hero_align",
      "label": "Hero alignment",
      "type": "select",
      "options": [
        "left",
        "center"
      ],
      "default": "left",
      "category": "Hero"
    },
    {
